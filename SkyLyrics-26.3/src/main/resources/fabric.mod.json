{
  "schemaVersion": 1,
  "id": "skylyrics",
  "version": "${version}",
  "name": "SkyLyrics",
  "description": "SkyLyrics — fully in-game local music playback, in-game file browser, synchronized lyrics, customizable HUD, and cinematic sky presets for Minecraft Java 26.3.",
  "authors": [
    "Sky"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.skyrevo.skylyrics.SkyLyricsClient"
    ]
  },
  "mixins": [
    "skylyrics.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.165.0"
  },
  "icon": "assets/skylyrics/icon.png"
}
