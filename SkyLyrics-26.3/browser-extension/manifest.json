{
  "manifest_version": 3,
  "name": "SkyLyrics Media Connector",
  "version": "0.6.0",
  "description": "Connects YouTube, YouTube Music, and Spotify Web to SkyLyrics Music Center for playback controls and synced metadata. Audio is played by the browser and never captured.",
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://www.youtube.com/*",
    "https://open.spotify.com/*",
    "http://127.0.0.1:38173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*",
        "https://www.youtube.com/watch*",
        "https://open.spotify.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
