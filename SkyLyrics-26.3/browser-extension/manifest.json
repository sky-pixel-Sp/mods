{
  "manifest_version": 3,
  "name": "SkyLyrics Media Connector",
  "version": "0.5.0",
  "description": "Sends YouTube, YouTube Music, and Spotify Web Player metadata and cover-art URLs to SkyLyrics locally. No audio is captured.",
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://www.youtube.com/*",
    "https://open.spotify.com/*",
    "http://127.0.0.1:38173/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": [
      "https://music.youtube.com/*",
      "https://www.youtube.com/watch*",
      "https://open.spotify.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
